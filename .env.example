# Root env for `docker compose up` — the centralized-deployment stack only.
# apps/api and apps/web each have their own .env.example for local (non-Docker) dev.

# Required: same constraint as apps/api's JWT_SECRET (min 16 chars). Generate
# with `openssl rand -hex 32` or similar — do not reuse the local dev secret.
JWT_SECRET=change-this-to-a-long-random-string

# The origin terminals' browsers will actually use to reach apps/web, e.g.
# http://192.168.1.50:3000 for a shop LAN. Used for apps/api's CORS allow-list.
WEB_ORIGIN=http://localhost:3000
